{
  "name": "@dsh-mobile/dsh-mobile-attachment-sources",
  "version": "0.1.2-dshm.1",
  "description": "Opt-in composer-integrated attachment source buttons using the frozen DSH native file input",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
